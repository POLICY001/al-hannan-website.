                <label className="block text-xs font-bold text-gray-700 mb-1">Image URL</label>
                <input 
                  type="url" 
                  placeholder="Paste direct image link (Unsplash, Imgur, etc.)"
                  value={newImage.url}
                  onChange={(e) => setNewImage({ ...newImage, url: e.target.value })}
                  className="w-full p-2.5 rounded-xl border border-gray-200 text-xs focus:outline-none focus:border-[#4B1D5A]"
                  required
                />
              </div>

              <button 
                type="submit"
                className="w-full bg-[#4B1D5A] text-white py-3 rounded-xl font-bold text-xs mt-2 hover:bg-purple-900 transition-colors"
              >
                Publish to Gallery
              </button>
            </form>
          </div>
        </div>
      )}

    </div>
  );
}
